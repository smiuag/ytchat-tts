# PyInstaller / paquete distribuible
build/
dist/
*.spec
YTChat TTS/
YTChat TTS v*/
YTChat TTS.zip
YTChat TTS v*.zip
yt-dlp.exe

# Cache del audio esclavo: la crea el reproductor al lado del ejecutable, y
# corriendo desde el repositorio cae en la raiz. Son megas por video.
cache-audio/

# Cache del video completo, lo mismo pero mucho mas grande.
cache-video/

# Python
__pycache__/
*.py[cod]
/tmp*/

# Entorno virtual (lo crea construir.bat con uv). Miles de archivos: nunca va.
.venv/
venv/

# Indice de CodeGraph: es por clon y no viaja.
.codegraph/

# Logs
ytchat.log
# Registros del diagnóstico. Llevan volcado de entorno y trazas: no se suben.
ytchat-debug.log
ytchat-debug.log.*
ytchat-fallos.log

# Secretos de la API de YouTube (los gestiona la app desde Configuración)
credenciales.json
alias.json

# Historial de sesión (opción guardar_historial en config.ini)
historial.csv
historial.txt
# Historial de directos vistos (ventana Historial)
historial_lives.json
# Registro y carpeta del gestor de descargas (URLs, rutas y vídeos enteros)
/historial_descargas.json
/Descargas/

# Andamiaje de trabajo con agentes: no se versiona.
# Viaja si se copia la carpeta, no con un git clone.
.agents/
.claude/
.codex/
.claudeignore
.atl/
CLAUDE.md
claude.md
AGENTS.md
.ignore
.mcp.json
opencode.json
MD/
herramientas/

# El banco de QA si se versiona; sus grabaciones no. Llevan la salida
# cruda de la aplicacion, con el identificador del video que se estuvo viendo.
qa/salida/
prompts/
INFORME_*.md

# Scripts .bat locales sueltos. Los oficiales del proyecto SÍ se versionan.
*.bat
!instalar.bat
!ejecutar.bat
!construir.bat

# Editor / OS
.vscode/
*.swp
Thumbs.db
desktop.ini

# Logs que manda el amigo para diagnosticar. No se suben.
todosloslogs.txt

# carpeta que deja Playwright al capturar
.playwright-mcp/

# Cache de win32com, se regenera sola al cargar SAPI5.
gen_py/

# Configuracion personal: no se versiona, se genera desde la fabrica.
# La fuente canonica es config_predeterminada.py y la copia legible es
# config.predeterminado.ini. Ver MD/configuracion-predeterminada.md.
/config.ini

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
